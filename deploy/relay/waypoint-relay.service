[Unit]
Description=Waypoint opaque sync relay
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/waypoint-relay/authority.json

[Service]
Type=simple
User=waypoint-relay
Group=waypoint-relay
WorkingDirectory=/opt/waypoint-relay/current
EnvironmentFile=/etc/waypoint-relay/relay.env
ExecStart=/usr/bin/node /opt/waypoint-relay/current/dist-electron/node/relay/entry.js
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# Node/V8 and libsodium WASM require JIT/executable-memory transitions.
# MemoryDenyWriteExecute is therefore incompatible with this runtime.
ProtectProc=invisible
ProcSubset=pid
IPAddressDeny=any
IPAddressAllow=localhost
LimitNOFILE=4096
MemoryMax=768M
TasksMax=64
StandardOutput=journal
StandardError=journal
SyslogIdentifier=waypoint-relay
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
ReadWritePaths=/var/lib/waypoint-relay
ReadOnlyPaths=/etc/waypoint-relay
UMask=0077

[Install]
WantedBy=multi-user.target
