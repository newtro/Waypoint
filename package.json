{
  "name": "waypoint",
  "version": "0.0.0",
  "author": "Waypoint",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "24.15.x",
    "npm": "12.0.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.x",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@playwright/browser-chromium@1.62.1": true,
    "agent-browser@0.33.2": false,
    "electron-winstaller@5.4.0": false,
    "esbuild@0.28.1": false,
    "fsevents@2.3.3": true
  },
  "description": "Personal-first second-brain desktop application",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "preinstall": "node scripts/enforce-toolchain.mjs",
    "build": "npm run prepare:product-help && tsc -b && tsc -p tsconfig.preload.json && node scripts/copy-preload.mjs && vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dependencies": "npm audit --audit-level=low && npm audit signatures && npm run verify:dependency-policy && npm run verify:malware-advisories && npm run report:dependencies",
    "verify:dependency-policy": "tsx scripts/dependency-policy.ts",
    "verify:malware-advisories": "tsx scripts/malware-advisory-check.ts",
    "report:dependencies": "tsx scripts/dependency-report.ts",
    "report:sbom": "npm sbom --sbom-format cyclonedx --omit dev",
    "performance:baseline": "tsx scripts/performance-baseline.ts",
    "spike:cli": "tsx spikes/cli-capabilities.ts",
    "verify:cli-live": "tsx spikes/live-cli-verification.ts",
    "diagnose:chat-runtime": "tsx scripts/chat-runtime-diagnostics.ts",
    "relay:bootstrap-owner": "tsx scripts/relay-bootstrap-owner.ts",
    "verify:package-runtime": "tsx scripts/package-runtime-closure.ts",
    "prepare:product-help": "tsx scripts/prepare-product-help.ts",
    "verify:product-help": "tsx scripts/prepare-product-help.ts --verify",
    "verify:backup-worker": "npm run build && node scripts/backup-worker-proof.mjs",
    "verify:document-worker": "npm run build && node scripts/document-ingestion-proof.mjs",
    "spike:embeddings": "tsx spikes/embedding-benchmark.ts",
    "spike:embedding-compare": "tsx spikes/embedding-benchmark-harness.ts",
    "verify:embedding-candidates": "tsx spikes/embedding-benchmark-harness.ts",
    "prepare:fast-voice": "tsx scripts/prepare-fast-voice-assets.ts",
    "prepare:agent-browser": "tsx scripts/prepare-agent-browser-assets.ts",
    "verify:fast-voice": "npm run prepare:fast-voice && npm run build && tsx scripts/fast-voice-benchmark.ts",
    "package:dir": "npm run prepare:fast-voice && npm run prepare:agent-browser && npm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.8.4",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "selfsigned": "3.0.1",
    "sherpa-onnx-node": "1.13.4"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@playwright/browser-chromium": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "agent-browser": "0.33.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
