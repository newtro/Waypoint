{
  "name": "waypoint",
  "version": "0.0.0",
  "private": true,
  "description": "Personal-first second-brain desktop application",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.preload.json && cp dist-preload/preload.js dist-electron/electron/preload.cjs && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:cli": "tsx spikes/cli-capabilities.ts",
    "spike:embeddings": "tsx spikes/embedding-benchmark.ts",
    "spike:embedding-compare": "tsx spikes/embedding-benchmark-harness.ts",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
