{
  "name": "waypoint",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.x",
    "npm": "10.9.x"
  },
  "description": "Personal-first second-brain desktop application",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.preload.json && cp dist-preload/preload.js dist-electron/electron/preload.cjs && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dependencies": "npm audit --audit-level=high && npm run report:dependencies",
    "report:dependencies": "tsx scripts/dependency-report.ts",
    "report:sbom": "npm sbom --sbom-format cyclonedx --omit dev",
    "performance:baseline": "tsx scripts/performance-baseline.ts",
    "spike:cli": "tsx spikes/cli-capabilities.ts",
    "verify:cli-live": "tsx spikes/live-cli-verification.ts",
    "diagnose:chat-runtime": "tsx scripts/chat-runtime-diagnostics.ts",
    "relay:bootstrap-owner": "tsx scripts/relay-bootstrap-owner.ts",
    "verify:package-runtime": "tsx scripts/package-runtime-closure.ts",
    "verify:backup-worker": "npm run build && node scripts/backup-worker-proof.mjs",
    "verify:document-worker": "npm run build && node scripts/document-ingestion-proof.mjs",
    "spike:embeddings": "tsx spikes/embedding-benchmark.ts",
    "spike:embedding-compare": "tsx spikes/embedding-benchmark-harness.ts",
    "verify:embedding-candidates": "tsx spikes/embedding-benchmark-harness.ts",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.8.4",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
